# Copy to .env.prod and fill in all values before deploying.
# Never commit .env.prod to git.

# ─── LLM ────────────────────────────────────────────────
LOOPSEC_LLM_PROVIDER=anthropic
LOOPSEC_LLM_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=sk-ant-...

# ─── GitHub OAuth App ────────────────────────────────────
# Create at https://github.com/settings/developers
# Callback URL: https://<your-domain>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match the callback URL registered in your GitHub OAuth app
GITHUB_REDIRECT_URI=https://<your-domain>/auth/github/callback

# ─── JWT ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ─── Tools ───────────────────────────────────────────────
# ZAP runs as a sibling container — do not change this
ZAP_HOST=http://zap:8080
LOOPSEC_SEMGREP_RULES=auto
LOOPSEC_LOG_LEVEL=INFO

# ─── Paths ───────────────────────────────────────────────
# Mounted Docker volume — persists SQLite DB across restarts
LOOPSEC_WORK_DIR=/data

# ─── Frontend (build-time only — set in docker-compose.prod.yml) ─────────────
# VITE_API_URL=https://<your-domain>
