# LoopSec Configuration
# Copy to .env and fill in your values

# ─── LLM Provider ──────────────────────────────────────
# Using OpenAI (default)
OPENAI_API_KEY=sk-...

# Or switch to Anthropic:
# LOOPSEC_LLM_PROVIDER=anthropic
# LOOPSEC_LLM_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-...

# Model override (any LiteLLM-supported model)
# LOOPSEC_LLM_MODEL=gpt-4o

# ─── GitHub OAuth (required for the API server + UI) ───
# Create an OAuth App at: https://github.com/settings/developers
#   Homepage URL:         http://localhost:8000
#   Authorization callback URL: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ─── API Server ────────────────────────────────────────
# Generate a strong random secret: python3 -c "import secrets; print(secrets.token_hex(32))"
LOOPSEC_JWT_SECRET=change-me-to-a-long-random-string
LOOPSEC_JWT_EXPIRY_DAYS=30

# ─── Tools ──────────────────────────────────────────────
# ZAP (runs via Docker, API key disabled by default)
ZAP_HOST=http://localhost:8080
# ZAP_API_KEY=

# Semgrep rules ("auto", "p/security-audit", or path)
LOOPSEC_SEMGREP_RULES=auto

# ─── General ────────────────────────────────────────────
LOOPSEC_LOG_LEVEL=INFO
